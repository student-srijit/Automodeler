%%{init: {'theme': 'base', 'flowchart': {'curve': 'step'}, 'themeVariables': { 'primaryColor': '#ffffff', 'primaryBorderColor': '#333333', 'lineColor': '#666666', 'fontSize': '14px'}}}%%
flowchart TD
    %% Styling Classes
    classDef user fill:#e1bee7,stroke:#8e24aa,stroke-width:2px,color:#000
    classDef aws fill:#ffcc80,stroke:#e65100,stroke-width:2px,color:#000
    classDef db fill:#b3e5fc,stroke:#0288d1,stroke-width:2px,color:#000
    classDef llm fill:#c8e6c9,stroke:#388e3c,stroke-width:2px,color:#000
    classDef process fill:#fff9c4,stroke:#fbc02d,stroke-width:2px,color:#000

    %% Interface Layer
    subgraph "Frontend & API Interface"
        direction TB
        User((User<br/>Browser)):::user
        Amplify[AWS Amplify<br/>Frontend Hosting]:::aws
        API[Amazon API Gateway<br/>REST Endpoints]:::aws
        
        User --> Amplify
        Amplify --> API
    end

    %% Storage Layer
    subgraph "AWS Cloud Storage"
        S3[(Amazon S3<br/>Raw Data Lake & State)]:::aws
    end

    User -- "1. Uploads Raw CSV" --> S3
    
    %% Compute Layer
    subgraph "AWS Lambda Compute Environment"
        direction TB
        Lambda[AWS Lambda Container<br/>via Amazon ECR]:::aws
        
        subgraph "Serverless ETL Orchestrator"
            direction TB
            P0[pipeline.py]:::process
            P1[1. DataProfiler<br/>Infers Types & Stats]:::process
            P1_5[1.5 VisualProfiler<br/>Generates EDA PNGs]:::process
            P2[2. SchemaArchitect<br/>AI DDL Synthesis]:::process
            P3[3. ClusterProvisioner<br/>Serverless Deployment]:::process
            P5[5. DataTransformer<br/>Imputation & Cleansing]:::process
            P6[6. VectorEngine<br/>Batch Embedding & Bulk Insert]:::process
            P7[7. QueryOptimizer<br/>EXPLAIN & Indexing]:::process

            P0 --> P1 --> P1_5 --> P2 --> P3 --> P5 --> P6 --> P7
        end
        
        ChatAgent[IntelligentChatAgent<br/>RAG Interface]:::process
        AutoMLAgent[AutoMLAgent<br/>Machine Learning]:::process
        
        Lambda --> ETL_Pipeline
        Lambda --> ChatAgent
        Lambda --> AutoMLAgent
    end

    S3 -- "2. Event Trigger" --> Lambda
    API -- "Natural Language RAG" --> ChatAgent
    API -- "Execute AutoML" --> AutoMLAgent

    %% External Interactions
    P1_5 -- "3. Uploads EDA Plots" --> S3
    
    %% LLM Interactions
    subgraph "AI Models & LLM APIs"
        Groq[Groq API<br/>llama-3.3-70b]:::llm
        OpenRouter[OpenRouter API<br/>Nemotron 253B]:::llm
    end

    P2 -- "Prompt for DDL" --> Groq
    P7 -- "Prompt for Indexes" --> Groq
    ChatAgent -- "Contextual RAG" --> Groq
    AutoMLAgent -- "Code Reasoning Loop" --> OpenRouter

    %% DB Interactions
    subgraph "Database & Memory"
        CDB[(CockroachDB Serverless<br/>Relational & Vector Store)]:::db
    end

    P3 -- "ccloud cluster create" --> CDB
    P6 -- "INSERT INTO / Embeddings" --> CDB
    P7 -- "CREATE VECTOR INDEX" --> CDB
    ChatAgent -- "embedding <-> vector" --> CDB
